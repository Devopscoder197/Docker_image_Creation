pipeline {
    agent any

    environment {
        IMAGE_NAME = 'movie-booking-app'
        CONTAINER_NAME = 'movie-booking-container'
        HOST_PORT = '8081'
        CONTAINER_PORT = '80'
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Devopscoder197/DockerImae_Creation.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Stop Old Container') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${HOST_PORT}:${CONTAINER_PORT} \
                        ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Check Container') {
            steps {
                sh '''
                    docker ps
                    docker logs --tail 50 ${CONTAINER_NAME}
                '''
            }
        }
    }

    post {
        success {
            echo 'Docker application deployed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
